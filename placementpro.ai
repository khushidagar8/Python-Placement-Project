import tkinter as tk
from tkinter import ttk

root = tk.Tk()
root.title("PlacementPro AI - Placement Preparation System")
root.geometry("1000x650")
root.configure(bg="#0f172a")

# Heading
heading = tk.Label(
    root,
    text="PlacementPro AI",
    font=("Arial", 25, "bold"),
    bg="#0f172a",
    fg="white"
)
heading.pack(pady=(20, 5))

subtitle = tk.Label(
    root,
    text="AI-Based Placement Preparation & Skill Gap Analyzer",
    font=("Arial", 12),
    bg="#0f172a",
    fg="#94a3b8"
)
subtitle.pack()

# Dashboard
dashboard = tk.Frame(root, bg="#0f172a")
dashboard.pack(fill="both", expand=True, padx=30, pady=25)

def create_card(parent, title, value, color):
    card = tk.Frame(parent, bg="#1e293b", width=280, height=130)
    card.pack_propagate(False)

    tk.Label(
        card,
        text=title,
        font=("Arial", 12),
        bg="#1e293b",
        fg="#cbd5e1"
    ).pack(pady=(20, 10))

    tk.Label(
        card,
        text=value,
        font=("Arial", 22, "bold"),
        bg="#1e293b",
        fg=color
    ).pack()

    return card

cards = tk.Frame(dashboard, bg="#0f172a")
cards.pack(fill="x")

create_card(cards, "Skills Assessed", "0 Skills", "#38bdf8").pack(side="left", padx=10, expand=True)
create_card(cards, "Career Roles", "5 Roles", "#a78bfa").pack(side="left", padx=10, expand=True)
create_card(cards, "Placement Readiness", "Not Assessed", "#fbbf24").pack(side="left", padx=10, expand=True)

# Student section
student_frame = tk.Frame(dashboard, bg="#1e293b")
student_frame.pack(fill="x", padx=10, pady=25)

tk.Label(
    student_frame,
    text="Student Profile",
    font=("Arial", 16, "bold"),
    bg="#1e293b",
    fg="white"
).pack(pady=15)

tk.Label(
    student_frame,
    text="Enter your name:",
    font=("Arial", 11),
    bg="#1e293b",
    fg="white"
).pack()

name_entry = tk.Entry(student_frame, font=("Arial", 12), width=35)
name_entry.pack(pady=10)

# Skills
tk.Label(
    dashboard,
    text="Available Modules",
    font=("Arial", 16, "bold"),
    bg="#0f172a",
    fg="white"
).pack(anchor="w", padx=10)

modules = [
    "Skill Assessment",
    "Career Role Matcher",
    "Skill Gap Analysis",
    "Learning Roadmap",
    "Interview Preparation"
]

for module in modules:
    tk.Label(
        dashboard,
        text="   •  " + module,
        font=("Arial", 12),
        bg="#0f172a",
        fg="#cbd5e1"
    ).pack(anchor="w", padx=15, pady=3)

def start_assessment():
    name = name_entry.get().strip()

    if not name:
        status.config(text="Please enter your name first!", fg="#f87171")
    else:
        status.config(text=f"Welcome {name}! Assessment module coming next.", fg="#4ade80")

start_button = tk.Button(
    dashboard,
    text="START SKILL ASSESSMENT",
    font=("Arial", 12, "bold"),
    bg="#2563eb",
    fg="white",
    activebackground="#1d4ed8",
    activeforeground="white",
    relief="flat",
    padx=20,
    pady=12,
    command=start_assessment
)
start_button.pack(pady=25)

status = tk.Label(
    dashboard,
    text="",
    font=("Arial", 11),
    bg="#0f172a"
)
status.pack()

root.mainloop()
